  "components": {
    "schemas": {
      "CategoriaDto": {
        "required": [
          "nombre"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "maxLength": 100,
            "type": "string"
          }
        }
      },
      "LoginDto": {
        "required": [
          "correo",
          "password"
        ],
        "type": "object",
        "properties": {
          "correo": {
            "type": "string"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          }
        }
      },
      "ProductoDto": {
        "required": [
          "nombre",
          "precio",
          "stock",
          "idProveedor",
          "idCategoria"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "maxLength": 100,
            "type": "string"
          },
          "precio": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "stock": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "idProveedor": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "idCategoria": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ProveedorDto": {
        "required": [
          "nombre",
          "contacto"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "maxLength": 100,
            "type": "string"
          },
          "contacto": {
            "maxLength": 150,
            "type": "string"
          }
        }
      },
      "RefreshDto": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "UsuarioDto": {
        "required": [
          "nombre",
          "correo",
          "fechaDeNacimiento",
          "password"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "maxLength": 100,
            "type": "string"
          },
          "correo": {
            "maxLength": 150,
            "type": "string"
          },
          "fechaDeNacimiento": {
            "type": "string",
            "format": "date-time"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          }
        }
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "temperatureF": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
